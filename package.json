{
  "name": "wirewise",
  "version": "1.0.0",
  "description": "Interactive real-time electrical installation modeler, circuit simulator, and code compliance planner (PEC 2017 & IEC 60364).",
  "author": "John Ray O. Dalida",
  "license": "MIT",
  "type": "module",
  "main": "electron/main.cjs",
  "repository": {
    "type": "git",
    "url": "https://github.com/jro-d/wirewise.git"
  },
  "scripts": {
    "dev": "vite",
    "check:catalog": "node scripts/check-catalog.mjs",
    "build": "node scripts/check-catalog.mjs && tsc && vite build",
    "desktop:icons": "node scripts/generate-icons.mjs",
    "desktop:preview": "npm run build && electron .",
    "desktop:build:dir": "npm run desktop:icons && npm run build && electron-builder --win --dir",
    "desktop:build:win": "npm run desktop:icons && npm run build && electron-builder --win",
    "preview": "vite preview",
    "test": "node tests/run-all.mjs"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.7.0",
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "esbuild": "^0.25.12",
    "lucide-react": "^1.77.0",
    "postcss": "^8.5.33",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^6.0.3"
  },
  "overrides": {
    "minimatch@>=7.0.0 <11.0.1": "^11.0.9"
  }
}
